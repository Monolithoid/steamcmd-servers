# Copy this file to vps/updateGaming.env, then adjust values.
# The script sources this file directly, so exports are not required.

STEAMCMD_BIN="steamcmd"
LOG_DIR="/tmp/steamcmd-updates"
SERVER_OWNER="1000:1000"

RUST_ENABLED="1"
RUST_INSTALL_DIR="/opt/gaming/rust"

STARRUPTURE_ENABLED="1"
STARRUPTURE_INSTALL_DIR="/opt/gaming/starrupture"

ABIOTIC_FACTOR_ENABLED="1"
ABIOTIC_FACTOR_INSTALL_DIR="/opt/gaming/abioticfactor"

ICARUS_ENABLED="1"
ICARUS_INSTALL_DIR="/opt/gaming/icarus"

NITROX_ENABLED="1"
NITROX_RELEASE_REPO="SubnauticaNitrox/Nitrox"
NITROX_VERSION="latest"
NITROX_ARCH="x64"
NITROX_INSTALL_DIR="/opt/gaming/subnautica-nitrox"
NITROX_OWNER="${SERVER_OWNER}"
SUBNAUTICA_INSTALL_DIR="/opt/gaming/subnautica"
