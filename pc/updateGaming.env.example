# Copy this file to pc/updateGaming.env, then adjust values.
# The script sources this file directly, so exports are not required.

VPS_SSH_TARGET="<ssh_user>@<vps_host>"
VPS_SSH_PORT="22"
VPS_BASE_DIR="/opt/gaming"
VPS_OWNER="1000:1000"
VPS_SUDO="sudo"
VPS_RSYNC_PATH="sudo rsync"

PC_STEAM_APPS_DIR="${HOME}/steamcmd-servers/apps"
LOG_DIR="${HOME}/steamcmd-servers/logs"
PC_RSYNC_DELETE="1"
PC_RSYNC_COMPRESS="1"
PC_RSYNC_EXTRA_ARGS=""

ASSETTO_CORSA_ENABLED="1"
ASSETTO_CORSA_LOCAL_DIR="${PC_STEAM_APPS_DIR}/assetto-corsa"
ASSETTO_CORSA_REMOTE_DIR="${VPS_BASE_DIR}/assetto-corsa"

SUBNAUTICA_ENABLED="1"
SUBNAUTICA_LOCAL_DIR="${PC_STEAM_APPS_DIR}/subnautica"
SUBNAUTICA_REMOTE_DIR="${VPS_BASE_DIR}/subnautica"
